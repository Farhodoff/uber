{
  "name": "uber-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "services/*"
  ],
  "scripts": {
    "test:frontend": "npm --prefix frontend test -- --run",
    "test:services": "vitest run services",
    "test": "npm run test:services && npm run test:frontend",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:frontend"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vite": "^6.0.5",
    "vitest": "^4.0.18"
  }
}
